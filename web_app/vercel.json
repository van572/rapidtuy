{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/promo", "destination": "/rapidtuy_promo_flyer.jpg" },
    { "source": "/flyer", "destination": "/flyer.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
